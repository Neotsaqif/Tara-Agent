# TARA AGENT — backend environment template (copy to `.env`).
# NEVER commit real credentials. Keep `.env` local only.

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=development
API_BASE_URL=http://localhost:8000
# Comma-separated exact origins. Keep this narrow in production.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────
# Local dev default is SQLite; production target is PostgreSQL.
# PostgreSQL example: postgresql+psycopg://tara:CHANGE_ME@localhost:5432/tara
DATABASE_URL=sqlite:///./tara.db

# ── Authentication ────────────────────────────────────────────────────
# Generate a strong value, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
TARA_JWT_SECRET=
TARA_JWT_EXPIRE_MINUTES=60
TARA_REFRESH_EXPIRE_DAYS=14
# Seed users are ONLY created when this flag is explicitly true in development.
TARA_ENABLE_DEV_SEED=false

# ── LLM provider ──────────────────────────────────────────────────────
# Use `mock` for offline/dev/tests. Use `gemini` for live Gemini.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ── GEOAI ─────────────────────────────────────────────────────────────
# Provider choices: `none` (off), `mock` (deterministic, synthetic), `osm` (real OpenStreetMap/PBF)
GEOAI_PROVIDER=none
GEOAI_OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOAI_TIMEOUT_SECONDS=20
GEOAI_CACHE_TTL_SECONDS=3600
GEOAI_USER_AGENT=TARAAgent/1.0

# ── POS integration ───────────────────────────────────────────────────
# Provider choices: `none`, `mock` (local mock HTTP server), `csv` (manual CSV import only)
POS_PROVIDER=none
POS_API_BASE_URL=
POS_API_KEY=
POS_TIMEOUT_SECONDS=20
POS_PROVIDER_NAME=generic
